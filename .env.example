# Copy to .env (never commit it) or set these in your hosting provider's secret settings.
# Lines marked REQUIRED have no default: the server refuses to start without them.

# ── Database (REQUIRED) ───────────────────────────────────────────────────────
DB_URL=jdbc:mysql://localhost:3306/uniguard?useSSL=true&serverTimezone=UTC&rewriteBatchedStatements=true
DB_USERNAME=uniguard
DB_PASSWORD=change-me

# ── Authentication (REQUIRED) ─────────────────────────────────────────────────
# At least 32 characters. Generate: openssl rand -base64 48
JWT_SECRET=
# Access token lifetime; the browser renews it silently from the refresh cookie.
JWT_EXPIRATION_MINUTES=15

# Login cookies (HttpOnly). Lax = frontend and API on the same site (recommended: serve /api
# through the frontend domain). None = different sites (requires HTTPS). false only for local http.
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_SECURE=true
# AUTH_COOKIE_DOMAIN=.your-university.edu
# Days a device stays signed in before the password is needed again; active devices per user.
AUTH_SESSION_DAYS=7
AUTH_MAX_SESSIONS_PER_USER=20
# Lock an account after N consecutive wrong passwords (0 = off), for this many minutes (2880 = 2 days)
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION_MINUTES=2880

# ── First administrator (only used when no administrator exists yet) ──────────
BOOTSTRAP_ADMIN_EMAIL=admin@your-university.edu
BOOTSTRAP_ADMIN_PASSWORD=
# Set to true for ONE restart to reset that account's password, then remove it.
BOOTSTRAP_ADMIN_RESET_PASSWORD=false

# ── Platform owner (optional; the owner panel: create universities, switch them off/on) ──
# Belongs to no university and never sees university data. Use an email no university account uses.
# Created only when no owner exists yet.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
# Set to true for ONE restart to reset the owner's password, then remove it.
BOOTSTRAP_OWNER_RESET_PASSWORD=false

# ── CORS: exact frontend origins, comma-separated (no wildcards) ──────────────
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com

# ── Public demo (only on a dedicated demo deployment; sessions are read-only) ─
DEMO_MODE_ENABLED=false

# ── Email via Brevo (optional — without it "notify staff" is disabled) ────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Uni-Guard Schedules

# ── Invitation / password-reset links ─────────────────────────────────────────
# REQUIRED in production: the address of the frontend. Links in emails are built from it.
APP_FRONTEND_URL=https://schedules.your-university.edu
APP_INVITE_HOURS=72
APP_RESET_LINK_MINUTES=30
# Never true in production (writes working links to the log when email is not configured).
APP_LOG_ACCOUNT_LINKS=false

# Activity log: days to keep entries (0 = keep forever)
APP_AUDIT_RETENTION_DAYS=365

# ── Reverse proxy with a PUBLIC address (optional) ────────────────────────────
# Regex of proxy IPs allowed to set X-Forwarded-For. Private ranges are trusted by default.
# SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=
